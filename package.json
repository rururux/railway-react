{
  "name": "railway-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "m3": "pnpm -F \"mission-3-book-review\"",
    "mission-4-ssr:dev": "vite ./mission-4-ssr -c ./vite.config.ts",
    "mission-4-ssr:build": "pnpm run mission-4-ssr:build:client && pnpm run mission-4-ssr:build:server",
    "mission-4-ssr:build:client": "vite build ./mission-4-ssr -c ./vite.config.ts --outDir ./dist/client",
    "mission-4-ssr:build:server": "vite build ./mission-4-ssr -c ./vite.config.ts --outDir ./dist/server --ssr ./src/entry-server.tsx",
    "mission-4-ssr:preview": "vite preview ./mission-4-ssr -c ./vite.config.ts",
    "mission-4-ssr:serve": "swc ./mission-4-ssr/server.ts | cross-env NODE_ENV=production node",
    "mission-4-ssr:watch": "nodemon --watch ./mission-4-ssr -e ts,tsx,css,html --ignore ./mission-4-ssr/dist --exec \"pnpm mission-4-ssr:build && pnpm mission-4-ssr:serve\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.11.29",
    "@tailwindcss/vite": "^4.1.8",
    "@types/express": "^5.0.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@vitest/browser": "^3.1.4",
    "@vitest/coverage-v8": "^3.1.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "express": "^5.1.0",
    "globals": "^16.0.0",
    "happy-dom": "^17.5.6",
    "nodemon": "^3.1.10",
    "playwright": "^1.52.0",
    "sanitize-html": "^2.17.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vitest-browser-react": "^0.2.0"
  }
}
